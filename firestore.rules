rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation helper for User entity
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'rating']) &&
             data.uid is string && data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 200 &&
             data.rating is number && data.rating >= 0 && data.rating <= 4000;
    }

    // Validation helper for Match entity
    function isValidMatch(data) {
      return data.keys().hasAll(['userId', 'opponentName', 'result', 'pgn']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.opponentName is string && data.opponentName.size() <= 100 &&
             data.result is string && (data.result == 'win' || data.result == 'loss' || data.result == 'draw') &&
             data.pgn is string && data.pgn.size() <= 10000;
    }

    // 2. User Profiles Collection
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data) &&
                      request.resource.data.uid == resource.data.uid;
      allow delete: if false;

      // 3. User Match History Subcollection
      match /matches/{matchId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(matchId) && isValidMatch(request.resource.data);
        allow update, delete: if false;
      }
    }
  }
}
